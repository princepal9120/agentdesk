# ══════════════════════════════════════════════════════════════════
# AgentDesk — Environment Configuration
# ══════════════════════════════════════════════════════════════════
#
# ✅ MINIMUM REQUIRED (local demo — no DB/Redis install needed):
#
#   SARVAM_API_KEY=sk_...
#
# That's it. Run: uvicorn app.main:app --reload
#
# Everything else below is for production or advanced voice features.
# ══════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
DEV_AGENCY_ID=dev-agency
DEV_AGENCY_NAME=Local Demo Agency
VOICE_MODE=demo
VOICE_PROVIDER=sarvam

# ── AI Providers ─────────────────────────────────────────────────
# Required for the local Sarvam voice path:
SARVAM_API_KEY=sk_...
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-30b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_LANGUAGE=en-IN

# Optional — only needed for the legacy OpenAI/full provider paths:
# OPENAI_API_KEY=sk-...

# Optional — only needed for full production voice stack:
# DEEPGRAM_API_KEY=...
# CARTESIA_API_KEY=...

# ── Database ─────────────────────────────────────────────────────
# Default: SQLite file in project root (agentdesk.db) — zero install
# For production Postgres:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentdesk

# ── Redis ─────────────────────────────────────────────────────────
# Optional — used for distributed rate limiting in production only.
# Leave unset for local dev (in-memory rate limiting used instead).
# REDIS_URL=redis://localhost:6379/0

# ── LiveKit ───────────────────────────────────────────────────────
# Only needed for production WebRTC voice calls.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Telephony provider ───────────────────────────────────────────
# Use "twilio" for the existing US flow or "exotel" for an Indian Exotel
# trial/paid account. Exotel assigns the trial ExoPhone in its dashboard.
TELEPHONY_PROVIDER=exotel

# ── Twilio (optional) ─────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

# ── Exotel trial / Voice API ─────────────────────────────────────
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_ACCOUNT_SID=
# EXOTEL_API_BASE_URL=https://api.in.exotel.com
# EXOTEL_CALLER_ID=+919876543210
# EXOTEL_FLOW_URL=https://my.exotel.in/exoml/start/your-app-id
# EXOTEL_WEBHOOK_TOKEN=generate-a-long-random-value
# flow = Exotel flow reminder; livekit = conversational AgentDesk reminder.
# EXOTEL_OUTBOUND_MODE=livekit

# ── Exotel SIP ↔ LiveKit (conversational calls) ──────────────────
# Use the exact edge hostname/port Exotel gives you, commonly TLS on 443.
# EXOTEL_SIP_HOSTNAME=edge.in.exotel.com:443
# EXOTEL_SIP_USERNAME=
# EXOTEL_SIP_PASSWORD=
# Optional stored LiveKit outbound trunk ID:
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# LIVEKIT_AGENT_NAME=agentdesk-voice

# ── Public callbacks ─────────────────────────────────────────────
# PUBLIC_BASE_URL=https://your-api.example.com

# ── Stripe ────────────────────────────────────────────────────────
# Optional — only needed if enabling billing features.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_PRICE_ID=price_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_AGENCY_PRICE_ID=price_...
