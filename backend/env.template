# Healthcare Voice Agent - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LiveKit Configuration
# =============================================================================
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# =============================================================================
# AI Service API Keys
# =============================================================================
# Sarvam — end-to-end local voice provider (required for VOICE_PROVIDER=sarvam)
SARVAM_API_KEY=sk_your-sarvam-api-key
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-30b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_LANGUAGE=en-IN

# OpenAI — only for the legacy OpenAI/full provider paths
# OPENAI_API_KEY=sk-your-openai-api-key

# Deepgram - legacy full provider only
DEEPGRAM_API_KEY=your-deepgram-api-key

# Cartesia - legacy full provider only
CARTESIA_API_KEY=your-cartesia-api-key

# =============================================================================
# Backend API Configuration
# =============================================================================
BACKEND_URL=http://localhost:8000

# =============================================================================
# Agent Configuration (Optional)
# =============================================================================
# Speech-to-Text
# Legacy Deepgram model (used only with VOICE_PROVIDER=full)
DEEPGRAM_MODEL=nova-2
AGENT_LANGUAGE=en-IN

# LLM
# Legacy OpenAI model (used only with VOICE_PROVIDER=openai/full)
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# Text-to-Speech (legacy Cartesia voice ID)
CARTESIA_VOICE_ID=248be419-c632-4f23-adf1-5324ed7dbf1d

# =============================================================================
# Database & Redis (for backend)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthcare_voice_agent
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Security (for backend)
# =============================================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-aes-256-encryption-key-change-in-production

# =============================================================================
# Telephony provider
# =============================================================================
# TELEPHONY_PROVIDER=exotel
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_ACCOUNT_SID=
# EXOTEL_API_BASE_URL=https://api.in.exotel.com
# EXOTEL_CALLER_ID=+919876543210
# EXOTEL_FLOW_URL=https://my.exotel.in/exoml/start/your-app-id
# EXOTEL_WEBHOOK_TOKEN=generate-a-long-random-value
# EXOTEL_OUTBOUND_MODE=livekit
# EXOTEL_SIP_HOSTNAME=edge.in.exotel.com:443
# EXOTEL_SIP_USERNAME=
# EXOTEL_SIP_PASSWORD=

# =============================================================================
# Optional: Twilio (for SMS notifications / legacy PSTN)
# =============================================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# =============================================================================
# Optional: Resend (for Email notifications)
# =============================================================================
# Get your API key from https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=HealthVoice <noreply@yourdomain.com>

# =============================================================================
# Optional: Twilio SIP (for PSTN inbound calls)
# =============================================================================
# Enable this if you want to receive real phone calls
# SIP_ENABLED=false
# LIVEKIT_SIP_DOMAIN=your-sip-domain.livekit.cloud
# SIP_TRUNK_USERNAME=
# SIP_TRUNK_PASSWORD=
